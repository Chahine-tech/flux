# syntax=docker/dockerfile:1
#
# The Temporal worker as an image. One stage, and it installs nothing from the
# workspace.
#
# An earlier version built inside the image: `corepack enable`, then
# `pnpm install --frozen-lockfile` over the whole monorepo, to produce a 396 KB
# bundle. That reinstalled ~350 packages the runner had just installed anyway,
# and it put an npm download on the critical path. It failed in CI with
# ECONNRESET while corepack fetched pnpm.
#
# So the build happens outside and this only assembles. Run first:
#   pnpm --filter @flux/worker build
#   pnpm --filter @flux/worker bundle-workflows
#   pnpm --filter @flux/worker runtime-manifest
#
# The trade is real: `docker build .` no longer works from a clean checkout.
# The CI job and deploy/kubernetes/README.md both spell out the order.
#
# Debian, not alpine: `@temporalio/worker` loads a native core-bridge shipped as
# a prebuilt glibc binary, so musl fails at dlopen.
FROM node:24-slim
WORKDIR /srv
ENV NODE_ENV=production

# Only what the bundler was told to leave out, at the version the build used.
# Generated by `runtime-manifest` from tsdown's own config, so the two cannot
# drift; see apps/worker/scripts/runtime-manifest.ts.
COPY apps/worker/dist/runtime-package.json ./package.json

# The cache has to go in the same layer, or it stays in the image.
RUN npm install --omit=dev --no-audit --no-fund \
 && npm cache clean --force \
 # core-bridge ships a prebuilt binary per platform, ~28 MB each, and a Linux
 # image will never load the macOS or Windows ones. Both Linux architectures
 # stay, so the same image definition works on amd64 and arm64.
 && rm -rf node_modules/@temporalio/core-bridge/releases/*-apple-darwin \
           node_modules/@temporalio/core-bridge/releases/*-windows-*

# dist carries two bundles for two reasons: main.mjs is ordinary Node code,
# workflow-bundle.js is deterministic code for the workflow VM.
COPY apps/worker/dist ./dist

# Bundled ahead of time; without this the worker falls back to resolving the
# workspace, which is not here.
ENV FLUX_WORKFLOW_BUNDLE=/srv/dist/workflow-bundle.js

# The Effect metric registry, scraped by Prometheus.
EXPOSE 9464

# No shell wrapper: the worker must receive SIGTERM directly so the Temporal
# SDK's own drain runs before the grace period expires (the knob D40 is about).
# Nothing here needs root: the process binds an unprivileged port and reads
# what the build put in place. The core-bridge is loaded from the image, not written to it.
# The chart enforces this again with `runAsNonRoot`, so an image that quietly
# went back to root would be refused rather than accepted.
USER node

CMD ["node", "dist/main.mjs"]
